# Copie para .env e preencha. Nunca commite o .env.
APP_ENV=development

# Gere com: uv run python -m core.security new-keys
SECRET_KEY=
TOKEN_ENCRYPTION_KEY=

# Usuário único. Gere o hash com: uv run python -m core.security hash-password
APP_USER=admin
APP_PASSWORD_HASH=

# Neon em produção (copie a URL do painel da Vercel). Local: Postgres do docker-compose.
DATABASE_URL=postgresql://fea:fea@localhost:5432/fea

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

LOG_LEVEL=INFO
