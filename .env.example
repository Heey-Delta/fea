# Copie para .env e preencha. Nunca commite o .env.
APP_ENV=development

# Gere com: uv run python -m core.security new-keys
SECRET_KEY=
TOKEN_ENCRYPTION_KEY=

# Login com GitHub (OAuth App em github.com/settings/developers).
# Callback do OAuth App: <PUBLIC_BASE_URL>/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Só esta conta entra (ID numérico do GitHub; Heey-Delta = 84813286).
GITHUB_ALLOWED_ID=84813286
PUBLIC_BASE_URL=http://localhost:8000
# Aparecem nas páginas públicas (/privacidade, /termos) que as plataformas pedem.
OPERATOR_NAME=Ferramenta de Operações
CONTACT_EMAIL=

# Neon em produção (copie a URL do painel da Vercel). Local: Postgres do docker-compose.
DATABASE_URL=postgresql://fea:fea@localhost:5432/fea

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Sem R2, os arquivos ficam nesta pasta (desenvolvimento).
STORAGE_DIR=storage

# As chaves das redes abaixo também podem ser preenchidas pela tela Acessos (ficam
# criptografadas no banco e valem para interface e workers). Variável aqui tem precedência.

# Reddit (Buscador): app em reddit.com/prefs/apps. Só uso não comercial na API gratuita.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=fea/0.1 (by u/seu_usuario)

# YouTube (Postador): cliente OAuth "Aplicativo da Web" no Google Cloud, com a YouTube Data API v3.
# URI de redirecionamento autorizado: {PUBLIC_BASE_URL}/contas/youtube/retorno
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_DAILY_UPLOAD_LIMIT=100

# X (Buscador): Bearer Token do app em developer.x.com (busca recente exige plano pago).
X_BEARER_TOKEN=

# TikTok (Publicador): app em developers.tiktok.com com Login Kit e Content Posting API.
# Redirect URI: {PUBLIC_BASE_URL}/contas/tiktok/retorno
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Instagram Reels (Publicador): app em developers.facebook.com com "Instagram API with
# Instagram Login". Redirect URI: {PUBLIC_BASE_URL}/contas/instagram/retorno
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

LOG_LEVEL=INFO
