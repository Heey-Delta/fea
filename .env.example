# Copie para .env e preencha. Nunca commite o .env.
APP_ENV=development

# Gere com: uv run python -m core.security new-keys
SECRET_KEY=
TOKEN_ENCRYPTION_KEY=

# Login com GitHub (OAuth App em github.com/settings/developers).
# Callback do OAuth App: <PUBLIC_BASE_URL>/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Só esta conta entra (ID numérico do GitHub; Heey-Delta = 84813286).
GITHUB_ALLOWED_ID=84813286
PUBLIC_BASE_URL=http://localhost:8000

# Neon em produção (copie a URL do painel da Vercel). Local: Postgres do docker-compose.
DATABASE_URL=postgresql://fea:fea@localhost:5432/fea

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Sem R2, os arquivos ficam nesta pasta (desenvolvimento).
STORAGE_DIR=storage

# Reddit (Buscador): app em reddit.com/prefs/apps. Só uso não comercial na API gratuita.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=fea/0.1 (by u/seu_usuario)

LOG_LEVEL=INFO
